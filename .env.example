# Copia questo file in ".env" e inserisci la tua chiave.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows cmd)
#
# La chiave si ottiene gratuitamente da Google AI Studio:
#   https://aistudio.google.com/app/apikey
#
# Il file .env e ignorato da git: NON committare mai la chiave reale.

GOOGLE_API_KEY=la-tua-chiave-google-ai-studio
